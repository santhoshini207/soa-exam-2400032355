
package com.klef.soa.exam.service;

import java.util.List;
import java.util.Optional;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.klef.soa.entity.MuseumMembership;
import com.klef.soa.repository.MuseumMembershipRepository;

@Service
public class MuseumMembershipServiceImpl implements MuseumMembershipService {

    @Autowired
    private MuseumMembershipRepository repo;

    @Override
    public MuseumMembership addMembership(MuseumMembership m) {
        return repo.save(m);
    }

    @Override
    public MuseumMembership updateMembership(MuseumMembership m) {

        Optional<MuseumMembership> optional = repo.findById(m.getId());

        if (optional.isPresent()) {
            MuseumMembership membership = optional.get();

            membership.setMemberName(m.getMemberName());
            membership.setMembershipType(m.getMembershipType());
            membership.setStartDate(m.getStartDate());
            membership.setAnnualFee(m.getAnnualFee());

            return repo.save(membership);

        } else {
            return null;
        }
    }

    @Override
    public String deleteMembershipById(Long id) {
        boolean flag = repo.existsById(id);

        if (flag) {
            repo.deleteById(id);
            return "Membership Deleted Successfully";

        } else {
            return "Membership ID Not Found";
        }
    }

    @Override
    public List<MuseumMembership> displayAllMemberships() {
        return repo.findAll();
    }

    @Override
    public MuseumMembership displayMembershipById(Long id) {
        return repo.findById(id).orElse(null);
    }

    @Override
    public List<MuseumMembership> displayMembershipByName(String memberName) {
        return repo.findByMemberName(memberName);
    }

    @Override
    public List<MuseumMembership> displayMembershipByType(String membershipType) {
        return repo.findByMembershipType(membershipType);
    }
}
